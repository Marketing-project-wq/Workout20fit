# 20fit Workout app — Supabase configuration (example)
#
# This app ships as a single-file static bundle (Workout 20FIT (1).html) served by
# server.js, so the Supabase URL + anon key are currently embedded inline in the
# bundle rather than read from the environment. These vars document the values a
# server/build step would use if/when the app is wired to read them.

# Public (safe to expose to the client) — anon / publishable key only.
SUPABASE_URL=https://cpvzwqptzcxnwzfzgrmt.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. NEVER commit the real value, never bundle it into client code.
# Not used by the current static app; add only if a server route/edge function needs it.
# SUPABASE_SERVICE_ROLE_KEY=server-only-do-not-commit
